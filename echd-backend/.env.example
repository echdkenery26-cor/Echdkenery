# ── Base de données ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echd?schema=public"

# ── Serveur ──
NODE_ENV=development
PORT=4000
# URL publique de l'API (utilisée pour fabriquer les liens de photos/documents)
API_URL=http://localhost:4000
# URL du frontend (liens de réinitialisation de mot de passe dans les e-mails)
APP_URL=http://localhost:3000
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
# Dossier des fichiers envoyés (photos). Sur un hébergeur, monter un volume persistant dessus.
UPLOAD_DIR=./uploads
# Images en production : Cloudinary (conservées entre les déploiements, sans disque persistant).
# Si cette ligne est renseignée, UPLOAD_DIR n'est plus utilisé. Format : cloudinary://CLE_API:SECRET_API@NOM_DU_CLOUD
# CLOUDINARY_URL=

# ── Sécurité ──
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars
# Secret de signature des liens de photos/documents (par défaut : JWT_SECRET)
FILES_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_DAYS=30
# Si le frontend est sur un autre domaine que l'API (ex. Vercel + Railway) :
#   COOKIE_SAMESITE=none  et  COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Nombre de proxys entre le visiteur et l'API (pour lire la vraie adresse IP).
# 1 = le site Next.js seul ou l'hébergeur seul ; 2 = site Next.js hébergé + proxy de l'hébergeur de l'API.
TRUST_PROXY=1

# ── E-mails. Vide = les e-mails sont seulement journalisés ──
# Option A (recommandée sur Render Free, où le SMTP sortant est bloqué) : API HTTPS Brevo
# BREVO_API_KEY=
# MAIL_FROM doit être une adresse expéditrice validée chez Brevo
# Option B : SMTP classique (Gmail, OVH…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ECHD <no-reply@exemple.org>"

# ── Tâches planifiées ──
CRON_TZ=Europe/Paris

# ── Documentation Swagger (/api/docs) ──
SWAGGER=true

# ── Seed (premier administrateur) ──
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
# Mettre entre guillemets si le mot de passe contient #  →  SEED_ADMIN_PASSWORD="Mon#Mdp2026"
SEED_ADMIN_PASSWORD=
